# The deterministic local provider is the safe default and needs no secret.
# Copy this file to .env for local development. .env is git-ignored.
ANESU_PROVIDER=deterministic
ANESU_MODEL=deterministic/echo
ANESU_STATE_DIR=~/.agent-harness-lab/anesu
# Computer-enabled turns default to at least 60 seconds beyond the browser
# task's 300-second grant. Keep this explicit value for a copied environment,
# or remove it to follow the code default when the task duration changes.
ANESU_TIMEOUT_MS=360000
ANESU_FIRST_EVENT_TIMEOUT_MS=12000
ANESU_APPROVAL_TIMEOUT_MS=120000
ANESU_MODEL_RETRY_ATTEMPTS=2
ANESU_MODEL_RETRY_BACKOFF_MS=250
ANESU_PROCESS_MODE=approval
ANESU_PROCESS_DURATION_MS=60000
ANESU_PROCESS_TERMINATION_GRACE_MS=500
ANESU_PROCESS_OUTPUT_BYTES=32768
ANESU_PROCESS_ARGUMENT_COUNT=64
ANESU_PROCESS_ARGUMENT_BYTES=32768
ANESU_PROCESS_CALLS_PER_TURN=4
ANESU_MEMORY_ENABLED=true
ANESU_MEMORY_USER_MAX_CHARS=1375
ANESU_MEMORY_WORKSPACE_MAX_CHARS=2200
ANESU_MEMORY_DAILY_MAX_CHARS=12000
ANESU_MEMORY_DAILY_RETENTION_DAYS=30
ANESU_MEMORY_EVIDENCE_RETENTION_DAYS=30
ANESU_MEMORY_EVIDENCE_MAX_ENTRIES=10000
ANESU_MEMORY_MAX_RESULTS=10
ANESU_MEMORY_BOOTSTRAP_MAX_CHARS=4000
ANESU_BROWSER_ACTION_TIMEOUT_MS=30000
ANESU_BROWSER_ENABLED=true
ANESU_BROWSER_SEARCH_PROVIDER=bing
ANESU_BROWSER_SESSION_TIMEOUT_MS=1800000
ANESU_BROWSER_READ_RETRY_COUNT=1
ANESU_BROWSER_WAIT_MAX_MS=10000
ANESU_BROWSER_SNAPSHOT_MAX_CHARS=16000
ANESU_BROWSER_MAX_SNAPSHOT_REFERENCES=100
ANESU_BROWSER_MAX_TABS=8
ANESU_BROWSER_UPLOAD_MAX_BYTES=4194304
ANESU_BROWSER_ALLOWED_LOCAL_HOSTS=127.0.0.1,localhost
ANESU_WORKSPACE_ROOT=.
ANESU_MAX_FILE_BYTES=65536
ANESU_MAX_DIRECTORY_ENTRIES=200
ANESU_MAX_TREE_ENTRIES=2000
ANESU_MAX_TREE_BYTES=4194304
ANESU_MAX_TREE_DEPTH=32
ANESU_MAX_PATCH_SET_BYTES=262144
ANESU_MAX_TOOL_OUTPUT_BYTES=32768
ANESU_MAX_TOOL_DURATION_MS=10000
ANESU_MAX_MODEL_REQUEST_BYTES=524288
ANESU_MAX_MODEL_OUTPUT_BYTES=262144
ANESU_MAX_MODEL_TOOL_ROUNDS=16
ANESU_DETERMINISTIC_DELAY_MS=0

# Optional real-provider mode. Set these values in .env for repeated local development.
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Computer use is opt-in. The browser environment is the default validation path.
ANESU_COMPUTER_ENABLED=false
ANESU_COMPUTER_ENVIRONMENT=browser
ANESU_COMPUTER_SURFACE=auto
# Jev is the active development strategy. Traditional vision remains available
# only as an explicit later experiment; it is not an automatic fallback.
ANESU_COMPUTER_STRATEGY=typesafe
ANESU_COMPUTER_TRADITIONAL_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Required when selecting traditional/compare: confirm the selected model accepts image input.
ANESU_COMPUTER_TRADITIONAL_VISION=true
ANESU_COMPUTER_OPENROUTER_API_KEY=replace-me
ANESU_COMPUTER_TYPESAFE_MODEL=jev-latest
# Existing-profile attachment can expose live tabs, cookies, and storage. Keep it
# disabled unless a trusted UI authorization host is configured and reviewed.
ANESU_COMPUTER_EXISTING_PROFILE=false
ANESU_COMPUTER_BROWSER_VISIBLE=true
# The default follows Cua's pinned platform behavior: dom_event on Linux/macOS,
# trusted on Windows. Override explicitly only when you understand the route.
# ANESU_COMPUTER_BROWSER_INPUT_ROUTE=trusted
ANESU_COMPUTER_MAX_ACTIONS=8
# Whole computer-tool deadline for observation, model decision, approval, and one action.
ANESU_COMPUTER_DURATION_MS=30000
ANESU_COMPUTER_TASK_DURATION_MS=300000
ANESU_COMPUTER_RUN_RETENTION_MS=604800000
ANESU_COMPUTER_CLEANUP_MAX_ENTRIES=100
ANESU_COMPUTER_ARTIFACTS_ENABLED=false
ANESU_COMPUTER_ARTIFACT_RETENTION_MS=604800000
ANESU_COMPUTER_ARTIFACT_CLEANUP_MAX_ENTRIES=100
ANESU_COMPUTER_ARTIFACT_MAX_BYTES=4194304
ANESU_COMPUTER_ARTIFACT_MAX_WIDTH=1920
ANESU_COMPUTER_ARTIFACT_MAX_HEIGHT=1080
# Native Ubuntu/X11 requires an explicitly isolated DISPLAY. The active
# `typesafe` strategy requires CUA to expose a bounded accessibility tree and
# sends only those semantic candidates to Jev. Traditional vision and compare
# are retired from the configured computer surface.
ANESU_COMPUTER_CUA_DISPLAY_ID=primary
ANESU_COMPUTER_CUA_ISOLATED_DISPLAY=false
TYPESAFE_API_KEY=replace-me
