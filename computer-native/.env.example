# The deterministic local provider is the safe default and needs no secret.
# Copy this file to .env for local development. .env is git-ignored.
COMPUTER_NATIVE_PROVIDER=deterministic
COMPUTER_NATIVE_MODEL=deterministic/echo
COMPUTER_NATIVE_STATE_DIR=~/.agent-harness-lab/computer-native
COMPUTER_NATIVE_TIMEOUT_MS=30000
COMPUTER_NATIVE_FIRST_EVENT_TIMEOUT_MS=12000
COMPUTER_NATIVE_APPROVAL_TIMEOUT_MS=120000
COMPUTER_NATIVE_MODEL_RETRY_ATTEMPTS=2
COMPUTER_NATIVE_MODEL_RETRY_BACKOFF_MS=250
COMPUTER_NATIVE_PROCESS_MODE=approval
COMPUTER_NATIVE_PROCESS_DURATION_MS=60000
COMPUTER_NATIVE_PROCESS_TERMINATION_GRACE_MS=500
COMPUTER_NATIVE_PROCESS_OUTPUT_BYTES=32768
COMPUTER_NATIVE_PROCESS_ARGUMENT_COUNT=64
COMPUTER_NATIVE_PROCESS_ARGUMENT_BYTES=32768
COMPUTER_NATIVE_PROCESS_CALLS_PER_TURN=4
COMPUTER_NATIVE_MEMORY_ENABLED=true
COMPUTER_NATIVE_MEMORY_USER_MAX_CHARS=1375
COMPUTER_NATIVE_MEMORY_WORKSPACE_MAX_CHARS=2200
COMPUTER_NATIVE_MEMORY_DAILY_MAX_CHARS=12000
COMPUTER_NATIVE_MEMORY_DAILY_RETENTION_DAYS=30
COMPUTER_NATIVE_MEMORY_MAX_RESULTS=10
COMPUTER_NATIVE_MEMORY_BOOTSTRAP_MAX_CHARS=4000
COMPUTER_NATIVE_BROWSER_ACTION_TIMEOUT_MS=10000
COMPUTER_NATIVE_BROWSER_ENABLED=true
COMPUTER_NATIVE_BROWSER_SESSION_TIMEOUT_MS=1800000
COMPUTER_NATIVE_BROWSER_READ_RETRY_COUNT=1
COMPUTER_NATIVE_BROWSER_WAIT_MAX_MS=10000
COMPUTER_NATIVE_BROWSER_SNAPSHOT_MAX_CHARS=16000
COMPUTER_NATIVE_BROWSER_MAX_SNAPSHOT_REFERENCES=100
COMPUTER_NATIVE_BROWSER_MAX_TABS=8
COMPUTER_NATIVE_BROWSER_PROFILE_RETENTION_MS=86400000
COMPUTER_NATIVE_BROWSER_ARTIFACT_RETENTION_MS=604800000
COMPUTER_NATIVE_BROWSER_CLEANUP_MAX_ENTRIES=100
COMPUTER_NATIVE_BROWSER_SCREENSHOT_MAX_BYTES=4194304
COMPUTER_NATIVE_BROWSER_SCREENSHOT_MAX_WIDTH=1920
COMPUTER_NATIVE_BROWSER_SCREENSHOT_MAX_HEIGHT=1080
COMPUTER_NATIVE_BROWSER_UPLOAD_MAX_BYTES=4194304
COMPUTER_NATIVE_BROWSER_DOWNLOAD_MAX_BYTES=4194304
COMPUTER_NATIVE_BROWSER_ALLOWED_LOCAL_HOSTS=127.0.0.1,localhost
COMPUTER_NATIVE_WORKSPACE_ROOT=.
COMPUTER_NATIVE_MAX_FILE_BYTES=65536
COMPUTER_NATIVE_MAX_DIRECTORY_ENTRIES=200
COMPUTER_NATIVE_MAX_TREE_ENTRIES=2000
COMPUTER_NATIVE_MAX_TREE_BYTES=4194304
COMPUTER_NATIVE_MAX_TREE_DEPTH=32
COMPUTER_NATIVE_MAX_TOOL_OUTPUT_BYTES=32768
COMPUTER_NATIVE_MAX_TOOL_DURATION_MS=10000
COMPUTER_NATIVE_MAX_MODEL_TOOL_ROUNDS=8
COMPUTER_NATIVE_DETERMINISTIC_DELAY_MS=0

# Optional real-provider mode. Set these values in .env for repeated local development.
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=cohere/north-mini-code:free
