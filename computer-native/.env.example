# The deterministic local provider is the safe default and needs no secret.
# Copy this file to .env for local development. .env is git-ignored.
COMPUTER_NATIVE_PROVIDER=deterministic
COMPUTER_NATIVE_MODEL=deterministic/echo
COMPUTER_NATIVE_STATE_DIR=~/.agent-harness-lab/computer-native
COMPUTER_NATIVE_TIMEOUT_MS=30000
COMPUTER_NATIVE_FIRST_EVENT_TIMEOUT_MS=12000
COMPUTER_NATIVE_WORKSPACE_ROOT=.
COMPUTER_NATIVE_MAX_FILE_BYTES=65536
COMPUTER_NATIVE_MAX_DIRECTORY_ENTRIES=200
COMPUTER_NATIVE_MAX_TOOL_OUTPUT_BYTES=32768
COMPUTER_NATIVE_MAX_TOOL_DURATION_MS=10000
COMPUTER_NATIVE_MAX_MODEL_TOOL_ROUNDS=4
COMPUTER_NATIVE_DETERMINISTIC_DELAY_MS=0

# Optional real-provider mode. Set these values in .env for repeated local development.
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=cohere/north-mini-code:free
