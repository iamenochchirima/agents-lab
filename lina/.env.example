# The deterministic local provider is the safe default and needs no secret.
# Copy this file to .env for local development. .env is git-ignored.
LINA_PROVIDER=deterministic
LINA_MODEL=deterministic/echo
LINA_STATE_DIR=~/.agent-harness-lab/lina
# Computer-enabled turns default to at least 60 seconds beyond the browser
# task's 300-second grant. Keep this explicit value for a copied environment,
# or remove it to follow the code default when the task duration changes.
LINA_TIMEOUT_MS=360000
LINA_FIRST_EVENT_TIMEOUT_MS=12000
LINA_APPROVAL_TIMEOUT_MS=120000
LINA_MODEL_RETRY_ATTEMPTS=2
LINA_MODEL_RETRY_BACKOFF_MS=250
LINA_PROCESS_MODE=approval
LINA_PROCESS_DURATION_MS=60000
LINA_PROCESS_TERMINATION_GRACE_MS=500
LINA_PROCESS_OUTPUT_BYTES=32768
LINA_PROCESS_ARGUMENT_COUNT=64
LINA_PROCESS_ARGUMENT_BYTES=32768
LINA_PROCESS_CALLS_PER_TURN=4
LINA_MEMORY_ENABLED=true
LINA_MEMORY_USER_MAX_CHARS=1375
LINA_MEMORY_WORKSPACE_MAX_CHARS=2200
LINA_MEMORY_DAILY_MAX_CHARS=12000
LINA_MEMORY_DAILY_RETENTION_DAYS=30
LINA_MEMORY_EVIDENCE_RETENTION_DAYS=30
LINA_MEMORY_EVIDENCE_MAX_ENTRIES=10000
LINA_MEMORY_MAX_RESULTS=10
LINA_MEMORY_BOOTSTRAP_MAX_CHARS=4000
LINA_BROWSER_ACTION_TIMEOUT_MS=30000
LINA_BROWSER_ENABLED=true
LINA_BROWSER_SEARCH_PROVIDER=bing
LINA_BROWSER_SESSION_TIMEOUT_MS=1800000
LINA_BROWSER_READ_RETRY_COUNT=1
LINA_BROWSER_WAIT_MAX_MS=10000
LINA_BROWSER_SNAPSHOT_MAX_CHARS=16000
LINA_BROWSER_MAX_SNAPSHOT_REFERENCES=100
LINA_BROWSER_MAX_TABS=8
LINA_BROWSER_UPLOAD_MAX_BYTES=4194304
LINA_BROWSER_ALLOWED_LOCAL_HOSTS=127.0.0.1,localhost
LINA_WORKSPACE_ROOT=.
LINA_MAX_FILE_BYTES=65536
LINA_MAX_DIRECTORY_ENTRIES=200
LINA_MAX_TREE_ENTRIES=2000
LINA_MAX_TREE_BYTES=4194304
LINA_MAX_TREE_DEPTH=32
LINA_MAX_PATCH_SET_BYTES=262144
LINA_MAX_TOOL_OUTPUT_BYTES=32768
LINA_MAX_TOOL_DURATION_MS=10000
LINA_MAX_MODEL_REQUEST_BYTES=524288
LINA_MAX_MODEL_OUTPUT_BYTES=262144
LINA_MAX_MODEL_TOOL_ROUNDS=16
LINA_DETERMINISTIC_DELAY_MS=0

# Optional real-provider mode. Set these values in .env for repeated local development.
OPENROUTER_API_KEY=replace-me
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Computer use is opt-in. The browser environment is the default validation path.
LINA_COMPUTER_ENABLED=false
LINA_COMPUTER_ENVIRONMENT=browser
LINA_COMPUTER_SURFACE=auto
# Jev is the active development strategy. Traditional vision remains available
# only as an explicit later experiment; it is not an automatic fallback.
LINA_COMPUTER_STRATEGY=typesafe
LINA_COMPUTER_TRADITIONAL_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Required when selecting traditional/compare: confirm the selected model accepts image input.
LINA_COMPUTER_TRADITIONAL_VISION=true
LINA_COMPUTER_OPENROUTER_API_KEY=replace-me
LINA_COMPUTER_TYPESAFE_MODEL=jev-latest
# Existing-profile attachment can expose live tabs, cookies, and storage. Keep it
# disabled unless a trusted UI authorization host is configured and reviewed.
LINA_COMPUTER_EXISTING_PROFILE=false
LINA_COMPUTER_BROWSER_VISIBLE=true
# The default follows Cua's pinned platform behavior: dom_event on Linux/macOS,
# trusted on Windows. Override explicitly only when you understand the route.
# LINA_COMPUTER_BROWSER_INPUT_ROUTE=trusted
LINA_COMPUTER_MAX_ACTIONS=8
# Whole computer-tool deadline for observation, model decision, approval, and one action.
LINA_COMPUTER_DURATION_MS=30000
LINA_COMPUTER_TASK_DURATION_MS=300000
LINA_COMPUTER_RUN_RETENTION_MS=604800000
LINA_COMPUTER_CLEANUP_MAX_ENTRIES=100
LINA_COMPUTER_ARTIFACTS_ENABLED=false
LINA_COMPUTER_ARTIFACT_RETENTION_MS=604800000
LINA_COMPUTER_ARTIFACT_CLEANUP_MAX_ENTRIES=100
LINA_COMPUTER_ARTIFACT_MAX_BYTES=4194304
LINA_COMPUTER_ARTIFACT_MAX_WIDTH=1920
LINA_COMPUTER_ARTIFACT_MAX_HEIGHT=1080
# Native Ubuntu/X11 requires an explicitly isolated DISPLAY. The active
# `typesafe` strategy requires CUA to expose a bounded accessibility tree and
# sends only those semantic candidates to Jev. Traditional vision and compare
# are retired from the configured computer surface.
LINA_COMPUTER_CUA_DISPLAY_ID=primary
LINA_COMPUTER_CUA_ISOLATED_DISPLAY=false
TYPESAFE_API_KEY=replace-me
