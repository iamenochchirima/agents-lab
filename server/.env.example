# API
AGENTLAB_API_HOST=127.0.0.1
AGENTLAB_API_PORT=4318
AGENTLAB_API_ORIGIN=http://127.0.0.1:5173

# Local retained evidence. Relative paths resolve from the repository root when
# the server is started there.
AGENTLAB_RUN_ROOT=lab/runs

# Named local Temporal profile
AGENTLAB_TEMPORAL_ENDPOINT=localhost:7233
AGENTLAB_TEMPORAL_NAMESPACE=default
AGENTLAB_TEMPORAL_TASK_QUEUE=agentlab-temporal-baseline
AGENTLAB_TEMPORAL_ACTIVITY_TIMEOUT_MS=30000
AGENTLAB_TEMPORAL_QUERY_TIMEOUT_MS=1000
AGENTLAB_TEMPORAL_PRE_DISPATCH_RETRY_LIMIT=2
AGENTLAB_TEMPORAL_PRE_DISPATCH_RETRY_BACKOFF_MS=100

# Safe default. Add openrouter explicitly for an opt-in real-provider run.
# The local server and Temporal worker load these two values from server/.env.
AGENTLAB_ALLOWED_MODEL_PROVIDERS=fake
# OPENROUTER_API_KEY=replace-me
