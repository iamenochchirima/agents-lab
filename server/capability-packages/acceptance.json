{
  "schemaVersion": 1,
  "packages": [
    {
      "id": "task-workspace",
      "version": "2.0.0",
      "source": "mcp",
      "endpoint": "http://127.0.0.1:9197/mcp",
      "protocolVersion": "2026-07-28",
      "trustedContext": "session",
      "headersEnv": {
        "Authorization": "AGENTLAB_DOCUMENT_PROVIDER_AUTHORIZATION"
      },
      "tools": [
        {
          "remoteName": "task-workspace_list_files",
          "name": "task-workspace_list_files",
          "riskClass": "read"
        },
        {
          "remoteName": "task-workspace_read_file",
          "name": "task-workspace_read_file",
          "riskClass": "read"
        },
        {
          "remoteName": "task-workspace_search_files",
          "name": "task-workspace_search_files",
          "riskClass": "read"
        },
        {
          "remoteName": "task-workspace_write_file",
          "name": "task-workspace_write_file",
          "riskClass": "write",
          "effectContract": {
            "rejectionErrorCodes": [
              "DOCUMENT_INVALID_ARGUMENTS",
              "DOCUMENT_PATH_REJECTED",
              "DOCUMENT_WRITE_SCOPE",
              "DOCUMENT_CONTENT_LIMIT",
              "DOCUMENT_DIGEST_CONFLICT",
              "DOCUMENT_PATCH_MATCH"
            ]
          }
        },
        {
          "remoteName": "task-workspace_patch_file",
          "name": "task-workspace_patch_file",
          "riskClass": "write",
          "effectContract": {
            "rejectionErrorCodes": [
              "DOCUMENT_INVALID_ARGUMENTS",
              "DOCUMENT_PATH_REJECTED",
              "DOCUMENT_WRITE_SCOPE",
              "DOCUMENT_CONTENT_LIMIT",
              "DOCUMENT_DIGEST_CONFLICT",
              "DOCUMENT_PATCH_MATCH"
            ]
          }
        }
      ]
    },
    {
      "id": "task-procedures",
      "version": "1.0.0",
      "source": "skills",
      "root": "./skills"
    },
    {
      "id": "release-mcp",
      "version": "1.0.0",
      "source": "mcp",
      "endpoint": "http://127.0.0.1:9196/mcp",
      "protocolVersion": "2026-07-28",
      "tools": [
        {
          "remoteName": "release.lookup",
          "name": "release_lookup",
          "riskClass": "read"
        }
      ]
    },
    {
      "id": "release-api",
      "version": "1.0.0",
      "source": "http",
      "baseUrl": "http://127.0.0.1:9196",
      "operations": [
        {
          "name": "release_assign",
          "method": "PUT",
          "path": "/records",
          "riskClass": "write",
          "description": "Assign a documentation owner to Cedar and mark work in progress. Read the current record revision first. This does not mark the launch ready.",
          "inputSchema": {
            "type": "object",
            "properties": {
              "namespace": {
                "type": "string",
                "pattern": "^cap-[a-z0-9-]{1,90}$"
              },
              "key": {
                "type": "string",
                "enum": [
                  "cedar"
                ]
              },
              "expectedRevision": {
                "type": "integer",
                "minimum": 1
              },
              "owner": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "status": {
                "type": "string",
                "enum": [
                  "in_progress"
                ]
              }
            },
            "required": [
              "namespace",
              "key",
              "expectedRevision",
              "owner",
              "status"
            ],
            "additionalProperties": false
          }
        }
      ]
    }
  ],
  "profiles": [
    {
      "id": "workspace-agent",
      "version": "1.0.0",
      "packages": [
        "task-workspace",
        "task-procedures"
      ]
    },
    {
      "id": "service-agent",
      "version": "1.0.0",
      "packages": [
        "release-mcp",
        "release-api",
        "task-procedures"
      ]
    }
  ]
}
