{
  "name": "@agent-harness-lab/lab-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "description": "Fastify server for Agent Harness Lab.",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/control-plane/bootstrap/server.ts",
    "dev:dbos": "tsx watch src/platforms/dbos/service-entry.ts",
    "dev:inngest": "tsx watch src/platforms/inngest/service-entry.ts",
    "dev:trigger": "pnpm --filter @agent-harness-lab/trigger-dev-baseline run dev",
    "dev:worker": "tsx watch src/platforms/temporal/runner-adapter/worker-entry.ts",
    "dev:restate": "tsx watch src/platforms/restate/service-entry.ts",
    "dev:aws-step-functions": "tsx watch src/platforms/aws-step-functions/service-entry.ts",
    "dev:hatchet": "tsx watch src/platforms/hatchet/service/worker-host.ts",
    "dev:vercel-workflows": "pnpm --filter @agent-harness-lab/vercel-workflows-platform run dev",
    "start": "node dist/src/control-plane/bootstrap/server.js",
    "start:dbos": "node dist/src/platforms/dbos/service-entry.js",
    "start:inngest": "node dist/src/platforms/inngest/service-entry.js",
    "start:worker": "node dist/src/platforms/temporal/runner-adapter/worker-entry.js",
    "start:restate": "node dist/src/platforms/restate/service-entry.js",
    "start:aws-step-functions": "node dist/src/platforms/aws-step-functions/service-entry.js",
    "start:hatchet": "node dist/src/platforms/hatchet/service/worker-host.js",
    "start:vercel-workflows": "node dist/src/platforms/vercel-workflows/service-entry.js",
    "test": "pnpm run build && find dist/tests -type f -name '*.test.js' -print0 | xargs -0 node --test",
    "test:langgraph": "pnpm run build && find dist/tests/platforms/langgraph -type f -name '*.test.js' -print0 | xargs -0 node --test dist/integration-tests/langgraph-baseline.test.js",
    "test:mastra": "pnpm run build && node --test dist/tests/platforms/mastra/mastra-runner.test.js dist/integration-tests/mastra-baseline.test.js",
    "test:restate": "pnpm run build && find dist/tests/platforms/restate -type f -name '*.test.js' -print0 | xargs -0 node --test dist/integration-tests/restate-baseline.test.js",
    "test:dbos": "pnpm run build && node --test dist/tests/platforms/dbos/*.test.js dist/integration-tests/dbos-baseline.test.js",
    "test:inngest": "pnpm run build && node --test dist/tests/platforms/inngest/*.test.js dist/integration-tests/inngest-baseline.test.js",
    "test:temporal": "pnpm run build && node --test dist/integration-tests/temporal-baseline.test.js",
    "test:trigger": "pnpm run build && node --test dist/tests/platforms/trigger-dev/*.test.js dist/integration-tests/trigger-dev-baseline.test.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@trigger.dev/sdk": "4.5.14",
    "@mastra/core": "1.66.0",
    "@fastify/cors": "^11.3.0",
    "inngest": "4.20.0",
    "@restatedev/restate-sdk": "1.17.0",
    "@restatedev/restate-sdk-clients": "1.17.0",
    "@temporalio/client": "^1.23.0",
    "@temporalio/worker": "^1.23.0",
    "@temporalio/workflow": "^1.23.0",
    "apache-arrow": "18.1.0",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@restatedev/restate-sdk-testcontainers": "1.17.0",
    "@types/ms": "^2.1.0",
    "@types/node": "^26.5.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
