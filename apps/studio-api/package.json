{
  "name": "@agent-harness-lab/studio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm --filter @agent-harness-lab/studio-http-contract build && tsc -p tsconfig.json",
    "dev": "pnpm --filter @agent-harness-lab/studio-http-contract build && tsx watch src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "pnpm --filter @agent-harness-lab/studio-http-contract build && tsc -p tsconfig.json --noEmit",
    "test": "pnpm run build && node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@agent-harness-lab/studio-http-contract": "workspace:*",
    "@fastify/cors": "^11.3.0",
    "fastify": "^5.12.4"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "^4.23.13",
    "typescript": "7.0.2"
  }
}
